{
  "name": "solanacolombia-www",
  "type": "module",
  "version": "0.1.2",
  "scripts": {
    "dev": "pnpm db:pull && astro dev",
    "db:pull": "wrangler d1 export solana_builders --remote --output ./prod_dump.sql && rm -rf .wrangler/state/v3/d1 && wrangler d1 execute solana_builders --local --file=./prod_dump.sql && rm ./prod_dump.sql",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "biome format --write",
      "biome check --write"
    ],
    "*.astro": [
      "biome check --write"
    ],
    "*.{json,jsonc,css}": [
      "biome format --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@scure/base": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.4",
    "resend": "^6.28.1",
    "tailwindcss": "^4.3.3",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.4.16",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "ultracite": "~7.10.8",
    "wrangler": "^4.137.0"
  }
}
