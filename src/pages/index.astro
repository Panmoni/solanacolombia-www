---
// One-page hub for the Solana Colombia builder community (PAN-420).
// Design: Retícula Compacta. Copy follows the zero-budget builder funnel plan.
import Layout from "../layouts/Layout.astro";

const steps = [
  ["Entra al grupo", "Cuenta qué quieres construir."],
  ["Primer Envío", "Publica algo real, cuando quieras."],
  ["Retos semanales", "Uno nuevo cada semana."],
  ["Reputación", "Otros confirman tus envíos."],
  ["Compitan juntos", "Equipos para Colosseum y más."],
];

const mindset = [
  ["Envía antes de estar listo.", "Una versión fea y publicada vale más que una perfecta en tu cabeza."],
  ["Pregunta en público.", "Lo que preguntas en el grupo le sirve a diez personas más."],
  ["Las oportunidades se buscan.", "Cada semana publicamos hackathons, bounties y grants. Tú eliges uno y actúas."],
  ["Nadie te va a dar permiso.", "Ni una empresa, ni una fundación, ni nosotros. Empieza hoy."],
];

const levels = [
  ["Visitante", "Acabas de llegar"],
  ["Constructor", "1 envío verificado"],
  ["Shipper", "3 envíos verificados"],
  ["Núcleo", "Constante y ayuda a otros"],
];

const channels = [
  { name: "Telegram", desc: "Envíos, retos y preguntas.", handle: "Principal →", href: "https://t.me/Solana_Colombia" },
  { name: "YouTube", desc: "Shorts cada semana.", handle: "@SolanaColombia →", href: "https://www.youtube.com/@SolanaColombia" },
  { name: "Instagram", desc: "Los videos, en Reels.", handle: "@solana_colombia →", href: "https://www.instagram.com/solana_colombia" },
  { name: "X", desc: "Oportunidades y envíos.", handle: "@Solana_Colombia →", href: "https://x.com/Solana_Colombia" },
];
---

<Layout>
  <div class="wrap hero grid">
    <div class="copy">
      <h1>Construye. Envía.<br /><span>En público.</span></h1>
      <p class="lede">
        Comunidad de builders en Solana, desde Colombia. Aquí no hay premios ni
        promesas. <b>Hay gente que envía cosas reales y se ayuda a hacerlo.</b>
      </p>
      <div class="ctas">
        <a class="btn primary" href="https://t.me/Solana_Colombia">Únete al Telegram →</a>
        <a class="btn ghost" href="/builders">Mundo Builder</a>
      </div>
    </div>
    <aside class="demo" aria-label="Demostración del bot de reputación">
      <div class="top"><span>Grupo · Solana Colombia</span><em>demo</em></div>
      <div class="chat" id="chat" aria-live="polite">
        <div class="msg"><small>@dev_bogota</small><code>/ship</code> github.com/dev-bogota/bot-precios</div>
        <div class="msg bot"><small>bot</small>Envío registrado. Falta un vouch de alguien que ya haya enviado.</div>
        <div class="msg"><small>@builder_mde</small><code>/vouch</code> @dev_bogota</div>
        <div class="msg bot"><small>bot</small>✓ Confirmado. @dev_bogota ahora es <b>Constructor</b>.</div>
      </div>
      <div class="cmds">
        <button type="button" id="c-ship" data-c="ship">/ship</button>
        <button type="button" id="c-gracias" data-c="gracias">/gracias</button>
        <button type="button" id="c-rep" data-c="rep">/rep</button>
        <button type="button" id="c-top" data-c="top">/top</button>
      </div>
    </aside>
  </div>

  <section id="como">
    <div class="wrap grid">
      <div class="label">Cómo funciona</div>
      <div class="body">
        <h2>De la primera línea al primer equipo</h2>
        <p class="intro">Todo pasa en el grupo de Telegram, a la vista de todos. Avanzas al ritmo de lo que envías.</p>
        <ol class="steps">
          {steps.map(([title, text], i) => (
            <li><em>{String(i + 1).padStart(2, "0")}</em><b>{title}</b><span>{text}</span></li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap grid">
      <div class="label">Mentalidad</div>
      <div class="body">
        <h2>Lo técnico se aprende. Empezar es lo difícil.</h2>
        <div class="two">
          {mindset.map(([title, text]) => (
            <div><b>{title}</b><span>{text}</span></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="rep">
    <div class="wrap grid">
      <div class="label">Reputación</div>
      <div class="body">
        <h2>No hay dinero. Hay reputación.</h2>
        <p class="intro">El bot lleva la cuenta. Los builders con más envíos salen en nuestros videos y arman los equipos.</p>
        <div class="levels">
          {levels.map(([name, text]) => (
            <div><b>{name}</b><span>{text}</span></div>
          ))}
        </div>
        <p class="note">Solo suma lo que otros pueden verificar. Mensajes y reacciones no cuentan.</p>
      </div>
    </div>
  </section>

  <section id="canales">
    <div class="wrap grid">
      <div class="label">Canales</div>
      <div class="body">
        <div class="chan">
          {channels.map((c) => (
            <a href={c.href} aria-label={`${c.name}: ${c.desc}`}>
              <b>{c.name}</b><span>{c.desc}</span><small>{c.handle}</small>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="builders">
    <div class="wrap grid">
      <div class="label">Builders</div>
      <div class="body">
        <div class="mb">
          <p><b>Mundo Builder.</b> Tu perfil y tus proyectos. Entra con tu wallet de Solana.</p>
          <a class="btn ghost" href="/builders">Entrar →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Demo only: canned replies that show how the reputation bot (PAN-418) answers.
  const replies: Record<string, [string, string, string]> = {
    ship: ["/ship", "mi-primer-proyecto.vercel.app", "Envío registrado. Cuando alguien con envíos lo confirme, subes a Constructor."],
    gracias: ["/gracias", "@builder_mde", "+2 de reputación para @builder_mde por ayudarte."],
    rep: ["/rep", "", "Tienes 12 puntos · nivel Constructor · 1 envío verificado."],
    top: ["/top", "", "Top de la semana: 1. @builder_mde 48 · 2. @cali_codes 31 · 3. @dev_bogota 22"],
  };

  // ClientRouter swaps pages without reloading, so bind on every page load.
  document.addEventListener("astro:page-load", () => {
    const chat = document.getElementById("chat");
    if (chat) chat.scrollTop = chat.scrollHeight;

    const addMessage = (who: string, text: string, command?: string) => {
      if (!chat) return;
      const msg = document.createElement("div");
      msg.className = command === undefined ? "msg bot" : "msg";
      const author = document.createElement("small");
      author.textContent = who;
      msg.append(author);
      if (command) {
        const code = document.createElement("code");
        code.textContent = command;
        msg.append(code, " ");
      }
      msg.append(text);
      chat.append(msg);
      chat.scrollTop = chat.scrollHeight;
    };

    for (const button of document.querySelectorAll<HTMLButtonElement>(".cmds button")) {
      button.addEventListener("click", () => {
        const reply = replies[button.dataset.c ?? ""];
        if (!reply) return;
        const [command, arg, answer] = reply;
        addMessage("@tu", arg, command);
        setTimeout(() => addMessage("bot", answer), 350);
      });
    }
  });
</script>

<style>
  .grid { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: 20px; }
  .label { grid-column: 1 / 3; font: 500 11px/1.5 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding-top: 4px; }
  .body { grid-column: 3 / 13; min-width: 0; }
  a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .hero { padding-block: 48px 44px; align-items: start; row-gap: 28px; }
  .copy { grid-column: 1 / 7; min-width: 0; }
  h1 { font-weight: 500; font-size: clamp(38px, 5.2vw, 60px); line-height: 1; letter-spacing: -0.035em; margin: 0 0 18px; text-wrap: balance; }
  h1 span { color: var(--muted); }
  .lede { font-size: 17px; line-height: 1.55; color: var(--muted); max-width: 40ch; margin: 0 0 24px; }
  .lede b { color: var(--fg); font-weight: 500; }
  .ctas { display: flex; flex-wrap: wrap; gap: 8px; }
  .btn { display: inline-flex; padding: 10px 16px; font-size: 14px; font-weight: 500; border: 1px solid var(--fg); transition: background 0.15s, color 0.15s; }
  .btn.primary { background: var(--fg); color: var(--bg); }
  .btn.primary:hover { background: var(--accent); border-color: var(--accent); }
  .btn.ghost:hover { background: var(--fg); color: var(--bg); }

  .demo { grid-column: 7 / 13; min-width: 0; background: var(--panel); border: 1px solid var(--line); }
  .top { display: flex; justify-content: space-between; padding: 10px 14px; border-bottom: 1px solid var(--line); font: 500 11px var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: 0.06em; }
  .top em { font-style: normal; color: var(--accent); }
  .chat { height: 236px; overflow-y: auto; padding: 12px 14px; display: flex; flex-direction: column; gap: 8px; font-size: 13.5px; line-height: 1.45; }
  .chat :global(.msg) { max-width: 88%; padding: 7px 10px; background: var(--bg); border: 1px solid var(--line); }
  .chat :global(.msg small) { display: block; font: 500 11px var(--mono); color: var(--muted); margin-bottom: 2px; }
  .chat :global(.msg.bot) { border-color: var(--accent); background: var(--accent-soft); }
  .chat :global(.msg.bot small) { color: var(--accent); }
  .chat :global(code) { font: 500 12.5px var(--mono); color: var(--accent); }
  .cmds { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 14px; border-top: 1px solid var(--line); }
  .cmds button { font: 500 12px var(--mono); padding: 6px 10px; background: var(--bg); color: var(--fg); border: 1px solid var(--line); cursor: pointer; }
  .cmds button:hover { border-color: var(--accent); color: var(--accent); }

  section { border-top: 1px solid var(--line); padding-block: 36px; font-size: 15px; line-height: 1.55; }
  h2 { font-weight: 500; font-size: 22px; letter-spacing: -0.015em; line-height: 1.2; margin: 0 0 6px; text-wrap: balance; }
  .intro { color: var(--muted); margin: 0 0 18px; max-width: 64ch; }

  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); border-top: 1px solid var(--fg); }
  .steps li { padding: 12px 14px 0 0; }
  .steps em { font: 500 11px var(--mono); font-style: normal; color: var(--accent); display: block; margin-bottom: 4px; }
  .steps b { font-weight: 500; display: block; margin-bottom: 2px; }
  .steps span { font-size: 13.5px; color: var(--muted); }

  .two { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 28px; }
  .two div { padding-block: 10px; border-top: 1px solid var(--line); }
  .two b { font-weight: 500; }
  .two span { color: var(--muted); font-size: 14px; display: block; }

  .levels { display: flex; flex-wrap: wrap; font-size: 14px; margin-bottom: 14px; border: 1px solid var(--line); }
  .levels div { flex: 1 1 120px; padding: 10px 12px; border-right: 1px solid var(--line); }
  .levels div:last-child { border-right: 0; background: var(--accent-soft); }
  .levels b { font-weight: 500; display: block; }
  .levels span { font-size: 12.5px; color: var(--muted); }
  .note { font: 400 12px var(--mono); color: var(--muted); margin: 0; }

  .chan { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--fg); }
  .chan a { padding: 12px 14px 4px 0; }
  .chan b { font-weight: 500; display: block; }
  .chan span { color: var(--muted); font-size: 13.5px; display: block; }
  .chan small { font: 400 12px var(--mono); color: var(--muted); }
  .chan a:hover small, .chan a:first-child small { color: var(--accent); }

  .mb { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; background: var(--accent-soft); padding: 18px 20px; }
  .mb p { margin: 0; }

  @media (max-width: 820px) {
    .label, .body, .copy, .demo { grid-column: 1 / -1; }
    .label { margin-bottom: 10px; }
    .steps, .chan { grid-template-columns: 1fr 1fr; row-gap: 12px; }
    .two { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn { transition: none; }
  }
</style>
